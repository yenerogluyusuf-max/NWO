// Vorlagen für Programme in einzelnen Regionen (Wohnungsbau, Schulen, Krankenhäuser, Wasser, Straßen, Bahn, Strom, Breitband, Förderung,
// Wiederaufbau, Stadtsanierung, Restaurierung von Stätten). Alle Werte gelten für das GANZE LAND; der Spieler wählt den Ort, und sim/reich.ts
// (regionalPlan) rechnet Kosten, Dauer und Wirkungsgebiet auf die gewählten Provinzen um: Kapital nach `umfangFaktor` (wie in der Politik),
// Baupunkte und Schulden nach dem Bevölkerungsanteil, die Bauzeit nach der Wurzel daraus. Die Zahlen sind Spielparameter, keine Tatsachen.

import type { Effekt, Vorhaben } from "../../sim/reich-typen";
import { stoss, stuetze } from "./bau";

/** Wirkung während des Baus: ein kleiner Monatsstoß auf die Bauwirtschaft (Aufträge, Arbeit). */
const AUFTRAEGE: Effekt = { t: "knoten", id: "bauwirtschaft", d: 0.15 };

const vorlage = (
  o: Pick<Vorhaben, "id" | "name" | "text" | "kosten" | "abschluss" | "kehrseite"> &
    Partial<Pick<Vorhaben, "dauer" | "unterhalt" | "verlierer" | "voraus" | "bild" | "bereich" | "klasse" | "quelle" | "anker">> & { massnahme: string; kurz: string; nach?: "bevoelkerung" | "staetten" },
): Vorhaben => {
  const { massnahme, kurz, nach, ...rest } = o;
  return {
    bereich: "infrastruktur",
    klasse: "grossprojekt",
    voraus: [],
    bauwirkung: [AUFTRAEGE],
    ohnePflege: false,
    thema: "regional",
    quelle: "Spielvorhaben",
    ...rest,
    vorlage: { massnahme, kurz, ...(nach ? { nach } : {}) },
  };
};

