// Technologie: sehr große Investitionen in Meer, Luft, Biologie, Chips, Batterien und Wasserstoff, Quanten, Robotik und Werkstoffe.
// Jedes Feld ist eine Stufenkette mit langer Laufzeit. Mechanik: riesige Kosten (Baupunkte, Verwaltungskraft, Schulden), Voraussetzungen aus
// Bildung, Fachkräften, Energie, Partnerstaaten und Lizenzen (Sanktionsrisiko), UNGEWISSE DURCHBRÜCHE (`scheitern`: Der Wurf fällt bei einer
// Marke des Baufortschritts, deterministisch aus Spielstand und Vorhaben; Scheitern heißt: Geld verloren, Neubeginn bei null; dazu `ueberzug`
// für Verzögerung und Mehrkosten), später Ertrag mit Nebenwirkungen auf viele Bereiche, Konkurrenz und Spionage anderer Staaten und Kehrseiten.
// Alle Zahlen sind Spielparameter; als Maßstab dient eine Analogie aus der Wirklichkeit (`anker`), nie eine erfundene Genauigkeit.

import type { Vorhaben } from "../../sim/reich-typen";
import { stoss, stuetze } from "./bau";
import { ARBEIT, AUFBRUCH, FORSCHUNG, SORGE, proj, utopie, vertrauen, type Pflicht } from "./zukunft";

type Eingabe = Partial<Vorhaben> & Pick<Vorhaben, Exclude<Pflicht, "thema">> & { feld: string };

/** Forschung und Entwicklung: Klasse „forschung“, Thema „technologie“. */
const tech = (o: Eingabe): Vorhaben => proj({ klasse: "forschung", thema: "technologie", ueberzug: { p: 0.6, band: [0.2, 0.5] }, ...o });
/** Unrealistische Technik: Jahrzehnte, riesige Kosten, ungewisser Durchbruch. */
const techUtopie = (o: Eingabe): Vorhaben => utopie({ thema: "technologie", scheitern: { p: 0.35, an: 0.5 }, ...o });

