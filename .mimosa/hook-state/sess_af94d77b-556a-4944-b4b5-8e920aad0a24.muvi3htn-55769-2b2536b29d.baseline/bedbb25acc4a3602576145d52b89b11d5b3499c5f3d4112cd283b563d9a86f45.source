export const TECHNOLOGIEN_NACH_ID = Object.fromEntries(
  TECHNOLOGIEN.map((t) => [t.id, t])
);

export const TECHNOLOGIEN_NACH_EPOCHE: Record<number, TechnologieDef[]> = {
  1: TECHNOLOGIEN.filter((t) => t.epoche === 1),
  2: TECHNOLOGIEN.filter((t) => t.epoche === 2),
  3: TECHNOLOGIEN.filter((t) => t.epoche === 3),
  4: TECHNOLOGIEN.filter((t) => t.epoche === 4),
  5: TECHNOLOGIEN.filter((t) => t.epoche === 5),
};
