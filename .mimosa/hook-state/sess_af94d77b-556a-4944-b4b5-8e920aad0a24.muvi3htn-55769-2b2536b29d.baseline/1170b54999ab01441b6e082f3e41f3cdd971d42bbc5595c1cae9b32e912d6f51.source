// Der Zukunftskatalog: Großvorhaben in Ketten (Raumfahrt, Künstliche Intelligenz, Verkehr und Welt, Städte, Energie und Wasser), dazu das
// ausdrücklich UNREALISTISCHE (Marsmission, Weltraumaufzug, Unterwasserstadt, Fusionskraftwerk, …): möglich, aber extrem schwierig und sehr teuer.
//
// Prinzip „unrealistisch realistisch“: Jede Zahl ist ein Spielparameter. Als Maßstab dient eine Analogie aus der Wirklichkeit (Feld `anker`),
// nie eine erfundene Genauigkeit. Die unrealistischen Vorhaben haben hohe Baupunkte und Bauzeiten in Jahrzehnten, riesige Schuldenwirkung,
// Voraussetzungen, die man nur über Vorstufen erreicht, deterministische Kostenüberschreitung, starken Widerstand und Ansehen als Gegenwert.
// Sie sind Langzeit- und Prestigeprojekte, keine Abkürzung zum Sieg: Während des Baus wirken Aufbruch und Lasten (`bauwirkung`), die Frucht
// kommt erst nach Jahren. Jedes Vorhaben nennt seinen Preis in mehreren Währungen (Kapital, Baupunkte, Verwaltungskraft, Schulden), seine
// Verlierer und seine Kehrseite.

import type { Bereich, Effekt, Klasse, Vorhaben } from "../../sim/reich-typen";
import type { VorteilDef } from "./typen";
import { stoss, stuetze } from "./bau";

// ---------------------------------------------------------------------------
// Bausteine

/** Aufträge und Arbeit während des Baus. */
export const ARBEIT = (d = 0.15): Effekt => ({ t: "knoten", id: "bauwirtschaft", d });
/** Aufbruchsstimmung und Ansehen während des Baus (nur bei Prestigeprojekten). */
export const AUFBRUCH = (d: number): Effekt => ({ t: "knoten", id: "ansehen", d });
/** Forschung und Hochschulen profitieren von Großvorhaben mit Technik. */
export const FORSCHUNG = (d = 0.08): Effekt => ({ t: "knoten", id: "hochschule", d });
/** Märkte beobachten Großvorhaben auf Pump kritisch. */
export const SORGE = (d: number): Effekt => ({ t: "knoten", id: "vertrauen_maerkte", d });

export type Pflicht = "id" | "name" | "text" | "kosten" | "abschluss" | "kehrseite" | "thema" | "stufe";

export const proj = (o: Partial<Vorhaben> & Pick<Vorhaben, Pflicht>): Vorhaben => ({
  bereich: "infrastruktur" as Bereich,
  klasse: "grossprojekt" as Klasse,
  voraus: [],
  einmalig: true,
  quelle: "Spielvorhaben",
  ...o,
});

/** Unrealistisch: Wunder, extrem teuer, Jahrzehnte, mit Überschreitung in mehreren Marken. */
export const utopie = (o: Partial<Vorhaben> & Pick<Vorhaben, Pflicht>): Vorhaben =>
  proj({
    klasse: "wunder",
    unrealistisch: true,
    ueberzug: { p: 0.9, band: [0.4, 1.2], an: [0.2, 0.45, 0.7] },
    ...o,
  });

export const vertrauen = (land: string, min: number) => ({ art: "land", land, dim: "vertrauen", min }) as const;

